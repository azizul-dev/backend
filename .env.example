# ─── Server ────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Database ──────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/attendance

# ─── JWT Secrets (use long random strings, MUST differ) ─
JWT_SECRET=change_me_jwt_secret_min_32_chars
QR_SECRET=change_me_qr_secret_must_differ_from_jwt

# ─── Display / QR screen key ───────────────────────────
DISPLAY_KEY=change_me_display_key

# ─── Frontend origin ───────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ─── Dev-only: bypass office IP/network check ──────────
DISABLE_OFFICE_CHECK=false

# ─── Admin seed credentials ────────────────────────────
SEED_ADMIN_NAME=Admin
SEED_ADMIN_PHONE=01700000000
SEED_ADMIN_PASSWORD=Admin@1234
